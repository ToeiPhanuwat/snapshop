# Values for the end-to-end test stack only (docker compose project "snapshop-e2e").
# Copy to .env.test and change the passwords; .env.test is not committed.
# Never use the real admin password or the real feed link here.
DB_PASSWORD=change-me-e2e-db
ADMIN_USERNAME=e2e-admin
ADMIN_PASSWORD=change-me-e2e-admin

# Empty = no feed look-ups during the tests
FEED_URL=

# Inbox folder of the test stack, so the tests never touch the real inbox/
INBOX_DIR=./frontend/e2e/.inbox
